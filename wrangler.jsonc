// Cloudflare Workers: serve the Vite build (`pnpm build` -> build/) as static
// assets. No Worker script, so requests never invoke billable Worker code.
// https://developers.cloudflare.com/workers/static-assets/
{
  // Production Worker (`wrangler deploy`).
  "name": "wireflow",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  },
  // Serve on <worker>.<subdomain>.workers.dev, but no public per-version URLs.
  "workers_dev": true,
  "preview_urls": false,
  "env": {
    // Staging Worker (`wrangler deploy --env staging`); inherits everything above.
    "staging": {
      "name": "wireflow-staging"
    }
  }
}
