# Build-time settings, all optional (README "Environment variables").
# Copy to .env.local for local builds; set them in the build environment for deploys.

# Analytics load only when these are set. The values wireflow.co used before
# they moved out of app/layout.tsx (public: they are in its HTML):
# NEXT_PUBLIC_GA_ID=G-GBPQX24QS2
# NEXT_PUBLIC_RYBBIT_SRC=https://dokploy-rybbit-059dcf.automatio.run/api/script.js
# NEXT_PUBLIC_RYBBIT_SITE_ID=3
# Rybbit's API key is for localhost tracking only and must not be deployed.

# 1 if the Cloudflare zone injects its Web Analytics beacon (lets the CSP allow it).
# CLOUDFLARE_WEB_ANALYTICS=1

# Proxy /blog and /blog/* to the Ghost blog from this app (production routes it outside the app).
# BLOG_ORIGIN=https://blog-origin.example.com

# off: ship the worker that removes the offline editor (rollback).
# NEXT_PUBLIC_OFFLINE=off

# Only for the live AI test (tests/unit/ai-live.test.ts); never needed by the app.
# ANTHROPIC_API_KEY=
